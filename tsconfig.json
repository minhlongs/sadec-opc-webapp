{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    // The scripts run under Node's type stripping, which requires an explicit
    // .ts extension in the import specifier.
        "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts"
  ],
  // The scripts are plain TypeScript run directly by Node's type stripping, and
  // they carry the guards that protect every database. Excluding them from
  // typechecking would let a syntax error in a destructive command pass the gate
  // that is supposed to catch it. The e2e specs are included for a related
  // reason: Playwright reports a type error as a test failure, so without this a
  // broken spec looks like a broken browser rather than a broken file, and
  // `pnpm verify` can stay green while no browser test compiled.
  "exclude": ["node_modules", ".claude", "dist"]
}
