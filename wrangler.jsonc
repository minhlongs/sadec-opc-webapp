{
  // The Worker and Static Assets for Sa Đéc Flow.
  //
  // Three D1 bindings, deliberately separate. §6 and §14 require demo, test and
  // pilot to be independent, so a test never runs against the database a demo
  // depends on, and a pilot never inherits sample data.
  //
  // `run_worker_first` routes API requests into the Worker regardless of whether
  // they would match a static asset. It is routing only. It protects nothing:
  // see docs/DECISIONS.md before adding an exception pattern such as
  // /api/public/*.
  "name": "sadec-flow",
  "compatibility_date": "2026-10-08",
  "main": "./src/worker/index.ts",
  // `run_worker_first` belongs inside `assets`, not at the top level. Wrangler
  // reads it from assets.run_worker_first and silently strips a top-level copy,
  // which leaves every /api/* request falling through to the asset router and
  // returning index.html — an error that looks exactly like a missing route.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // All three bindings are declared in this one file rather than selected from
  // whatever database happens to exist. §6 and §14 require demo, test and pilot
  // to be independent, so which database a command touches is stated here and
  // nowhere else.
  //
  // Local databases use a durable state directory rather than in-memory,
  // because §3 requires the local database to survive a restart so persistence
  // can be verified rather than assumed.
  "d1_databases": [
    {
      "binding": "sadec_demo",
      "database_name": "sadec-demo",
      "database_id": "local-demo"
    },
    {
      "binding": "sadec_test",
      "database_name": "sadec-test",
      "database_id": "local-test"
    },
    {
      // A restore target of its own. A backup carries the schema and the
      // migration ledger, so replaying it onto the working test database fails
      // on the ledger's primary key and would destroy the database the suite
      // depends on. §14 forbids a default path that could overwrite a real
      // database; this is that rule applied to the nearest call.
      "binding": "sadec_test_restore",
      "database_name": "sadec-test-restore",
      "database_id": "local-test-restore"
    }
  ],

  // Pilot is the private preview. Separate Worker-level Access protects the
  // workers.dev hostname and preview URLs, and preview URLs are disabled here as
  // a second measure. Disabling workers_dev would not disable them; see
  // docs/DECISIONS.md.
  "env": {
    "pilot": {
      "name": "sadec-flow-pilot",
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "sadec_pilot",
          "database_name": "sadec-pilot",
          "database_id": "replace-with-the-real-pilot-id"
        }
      ],
      "vars": {
        "APP_ENV": "pilot"
      }
    }
  }
}
