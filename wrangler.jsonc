{
  // The Worker and Static Assets for Sa Đéc Flow.
  //
  // Three D1 bindings, deliberately separate. §6 and §14 require demo, test and
  // pilot to be independent, so a test never runs against the database a demo
  // depends on, and a pilot never inherits sample data.
  //
  // `run_worker_first` routes API requests into the Worker regardless of whether
  // they would match a static asset. It is routing only. It protects nothing:
  // see docs/DECISIONS.md before adding an exception pattern such as
  // /api/public/*.
  "name": "sadec-flow",
  "compatibility_date": "2026-10-08",
  "main": "./src/worker/index.ts",
  // `run_worker_first` belongs inside `assets`, not at the top level. Wrangler
  // reads it from assets.run_worker_first and silently strips a top-level copy,
  // which leaves every /api/* request falling through to the asset router and
  // returning index.html — an error that looks exactly like a missing route.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // All three bindings are declared in this one file rather than selected from
  // whatever database happens to exist. §6 and §14 require demo, test and pilot
  // to be independent, so which database a command touches is stated here and
  // nowhere else.
  //
  // Local databases use a durable state directory rather than in-memory,
  // because §3 requires the local database to survive a restart so persistence
  // can be verified rather than assumed.
  "d1_databases": [
    {
      "binding": "sadec_demo",
      "database_name": "sadec-demo",
      "database_id": "local-demo"
    },
    {
      "binding": "sadec_test",
      "database_name": "sadec-test",
      "database_id": "local-test"
    },
    {
      // A restore target of its own. A backup carries the schema and the
      // migration ledger, so replaying it onto the working test database fails
      // on the ledger's primary key and would destroy the database the suite
      // depends on. §14 forbids a default path that could overwrite a real
      // database; this is that rule applied to the nearest call.
      "binding": "sadec_test_restore",
      "database_name": "sadec-test-restore",
      "database_id": "local-test-restore"
    },
    {
      // The pilot database, declared at the top level rather than only under
      // `env.pilot`.
      //
      // The deploy command runs `wrangler deploy --env pilot`, and that reads the
      // config the Cloudflare Vite plugin generates into dist/, which drops the
      // `env` section entirely: it records the environment name and then emits no
      // bindings, no vars and no Worker name for it. A pilot build therefore had
      // no `sadec_pilot` binding and no `APP_ENV`, so every guarded route
      // refused — on a Worker that passes every local gate and every unit test,
      // because tests inject their own binding.
      //
      // Declaring it here is safe because the Worker picks a binding by
      // `APP_ENV`, so a local run reading `local` never reaches this one, and a
      // pilot run reading `pilot` reaches only it. The `database_id` must be
      // replaced with the real pilot id before `deploy:preview` is run; a
      // placeholder id makes the deploy fail rather than silently binding to a
      // local database.
      "binding": "sadec_pilot",
      "database_name": "sadec-pilot",
      "database_id": "replace-with-the-real-pilot-id"
    }
  ],

  // Pilot is the private preview: the Worker `sadec-flow-pilot`, deployed by
  // `scripts/deploy-preview.ts`.
  //
  // There is deliberately no `env.pilot` section. One used to live here, and the
  // Cloudflare Vite plugin drops the whole `env` object when it generates the
  // config the deploy reads, so the source file said `APP_ENV: pilot` and
  // `sadec_pilot` while the built config said neither. A pilot deploy then had no
  // `APP_ENV` and no Worker name, and every guarded route refused — on a Worker
  // that had just passed every local gate and every unit test.
  //
  // Those values now come from the deploy command, which is the only place a
  // deployed Worker gets them, and `test/deploy-config.test.ts` asserts the
  // generated config carries the pilot binding so a regression fails a test
  // rather than a deployment.
  //
  // Separate Worker-level Access protects the workers.dev hostname. Preview URLs
  // are disabled for this Worker, because disabling `workers_dev` would not
  // disable them; see docs/DECISIONS.md.
}

