# Environment variables. Copy to .dev.vars for local work.
#
# .dev.vars is gitignored, and it is gitignored for a reason that is not
# decoration: the audience tag below is what makes a forged Access token look
# valid, so it is the one value that must never reach a repository.
#
# Nothing here holds a real value. Fill it in from the Cloudflare dashboard:
# Zero Trust > Access controls > Applications > the pilot application >
# Additional settings.

# Which environment this deployment is. One of local, test, demo, pilot.
# Keeps the dev identity adapter and the DEMO label honest about where they run.
APP_ENV=local

# Your Zero Trust team domain. The issuer of every Access token, and the host
# that publishes the public keys they are checked against.
ACCESS_TEAM_DOMAIN=

# The application's audience tag. A 64-character hex string.
ACCESS_AUD=

# The identity that receives founder_admin at bootstrap.
#
# Only an authenticated identity matching this becomes founder_admin. There is no
# path that grants it to the first person who logs in, and none that grants it
# because this value is missing — a deploy without it fails closed.
FOUNDER_EMAIL=
