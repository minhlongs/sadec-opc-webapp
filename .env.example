# Environment variables. Copy to .dev.vars for local work.
#
# .dev.vars is gitignored, and it is gitignored for a reason that is not
# decoration: the audience tag below is what makes a forged Access token look
# valid, so it is the one value that must never reach a repository.
#
# Nothing here holds a real value. Fill it in from the Cloudflare dashboard:
# Zero Trust > Access controls > Applications > the pilot application >
# Additional settings.

# Which environment this deployment is. One of local, test, demo, pilot.
# Keeps the dev identity adapter and the DEMO label honest about where they run.
APP_ENV=local

# Your Zero Trust team domain. The issuer of every Access token, and the host
# that publishes the public keys they are checked against.
ACCESS_TEAM_DOMAIN=

# The application's audience tag. A 64-character hex string.
ACCESS_AUD=

# There is deliberately no FOUNDER_EMAIL or FOUNDER_SUB here.
#
# Deploying the Worker grants nobody anything, and no code reads a founder value:
# the Worker resolves a role from a membership row, and the first membership is
# created by a provisioning command run by a person with database access:
#
#   pnpm bootstrap:founder -- --env pilot \
#     --workspace-id <id> --workspace-name "<name>" \
#     --access-sub <subject from a verified identity> \
#     --email <email> --reason "<why>" --apply --subject-verified
#
# The subject is an argument to that command, recorded in its audit row, and it
# is never a Worker secret. See docs/PILOT-RUNBOOK.md.

# The account a B2B buyer pays a deposit into.
#
# There is no default. Without all three values the app shows no VietQR at all
# and tells the buyer not to transfer anything; a booking is still recorded, and
# an operator confirms the deposit against a bank reference they checked.
# A built-in placeholder account number would be an instruction to send real
# money to an account this platform does not hold.
ESCROW_BANK_BIN=
ESCROW_ACCOUNT_NUMBER=
ESCROW_ACCOUNT_HOLDER=
